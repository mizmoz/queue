{
  "name": "mizmoz/queue",
  "description": "Mizmoz Queue Library",
  "website": "https://www.mizmoz.com/",
  "type": "library",
  "version": "1.0.0",
  "license": "MIT",
  "authors": [
    {
      "name": "Ian Chadwick",
      "email": "chad@mizmoz.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Mizmoz\\Queue\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mizmoz\\Queue\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.3",
    "ext-pcntl": "*",
    "mizmoz/container": "^2.0",
    "symfony/process": "^3.3"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "pda/pheanstalk": "^3.1",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^11.0",
    "symfony/console": "^3.3"
  },
  "suggest": {
    "mizmoz/app": "Required for app registration",
    "pda/pheanstalk": "Required when using Beanstalkd Queue",
    "symfony/console": "Required for running the queue listener command",
    "symfony/process": "Required for running the queue listener command"
  }
}
